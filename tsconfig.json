{
	"compilerOptions": {
		"target": "ES2017",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"types": ["vitest/globals", "@testing-library/jest-dom", "node"],
		"paths": {
			"@/*": ["./src/*"],
			"@cn": ["./src/lib/utils/cn.ts"],
			"@atoms/*": ["./src/components/common/atoms/*"],
			"@molecules/*": ["./src/components/common/molecules/*"],
			"@organisms/*": ["./src/components/common/organisms/*"],
			"@auth/*": ["./src/components/auth/*"],
			"@locales/*": ["./locales/*"],
			"@assets/*": ["./src/assets/*"],
			"@navigation": ["./src/i18n/navigation.ts"],
			"@hooks/*": ["./src/hooks/*"],
			"@contexts/*": ["./src/contexts/*"],
			"@hw-prisma/*": ["./src/lib/generated/prisma/*"],
			"@lib/*": ["./src/lib/*"],
			"@emails/*": ["./src/emails/*"],
			"@actions/*": ["./src/app/actions/*"],
			"@households/*": ["./src/components/households/*"],
			"@bank-accounts/*": ["./src/components/bank-accounts/*"],
			"@monthly-budgets/*": ["./src/components/monthly-budgets/*"],
			"@common/*": ["./src/components/common/*"]
		}
	},
	"include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts", "**/*.mts"],
	"exclude": ["node_modules"]
}
