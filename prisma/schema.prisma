// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  adapter           String   @id @default(cuid())
  userId            String   @map("user_id")
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  name          String
  image         String?
  role          String    @default("MEMBER")
  gender        String?
  createdAt     DateTime  @default(now()) @map("created_at")

  accounts     Account[]
  sessions     Session[]
  memberships  HouseholdMember[]
  transactions Transaction[]
  households   Household[]

  @@map("users")
}

model Household {
  id                String    @id @default(cuid())
  name              String
  fullAddress       String?   @map("full_address")
  code              String    @unique
  codeRegeneratedAt DateTime? @map("code_regenerated_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  createdById       String    @map("created_by_id")

  config       HouseholdConfig?
  members      HouseholdMember[]
  bankAccounts BankAccount[]
  categories   Category[]
  budgets      MonthlyBudget[]
  transactions Transaction[]
  tags         Tag[]
  aisummaries  AISummary[]
  user         User?             @relation(fields: [createdById], references: [id])

  @@unique([name, createdById])
  @@index([id])
  @@map("households")
}

model HouseholdConfig {
  id                   String    @id @default(cuid())
  householdId          String    @unique @map("household_id")
  household            Household @relation(fields: [householdId], references: [id])
  currency             String    @default("USD")
  defaultSplitStrategy String    @default("equal") @map("default_split_strategy") // TS enum: SPLIT_STRATEGY
  autoCategorize       Boolean   @default(true) @map("auto_categorize")
  aiAssistEnabled      Boolean   @default(true) @map("ai_assist_enabled")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([householdId])
  @@map("household_configs")
}

model HouseholdMember {
  id          String    @id @default(cuid())
  householdId String    @map("household_id")
  household   Household @relation(fields: [householdId], references: [id])
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("member") // TS enum: MEMBER_ROLE
  // monthlyIncome Float?    @map("monthly_income") // Used for proportional_to_income split // ! MAKE IT VIRTUALLY CALCULATED FROM HouseholdMemberPayroll for each MonthlyBudget
  createdAt   DateTime  @default(now()) @map("created_at")

  payments       Payment[]
  bankAccounts   BankAccount[]
  payrolls       HouseholdMemberPayroll[]
  monthlyBudgets MonthlyBudget[]

  @@index([householdId])
  @@map("household_members")
}

model HouseholdMemberPayroll {
  id                String          @id @default(cuid())
  householdMemberId String          @map("household_member_id")
  householdMember   HouseholdMember @relation(fields: [householdMemberId], references: [id])
  name              String
  amount            Float
  startDate         DateTime        @map("start_date")
  endDate           DateTime?       @map("end_date")
  createdAt         DateTime        @default(now()) @map("created_at")

  @@index([householdMemberId])
  @@map("household_member_payrolls")
}

model BankAccount {
  id                String          @id @default(cuid())
  householdId       String          @map("household_id")
  household         Household       @relation(fields: [householdId], references: [id])
  householdMemberId String          @map("household_member_id")
  householdMember   HouseholdMember @relation(fields: [householdMemberId], references: [id])
  name              String
  lastFourDigits    String?         @map("last_four_digits")
  type              String          @default("bank") // TS enum: ACCOUNT_TYPE
  createdAt         DateTime        @default(now()) @map("created_at")

  sourcePayments Payment[] @relation("SourcePayments")
  destPayments   Payment[] @relation("DestPayments")

  @@index([householdId])
  @@map("bank_accounts")
}

model MonthlyBudget {
  id                String           @id @default(cuid())
  householdId       String           @map("household_id")
  household         Household        @relation(fields: [householdId], references: [id])
  householdMemberId String?          @map("household_member_id")
  householdMember   HouseholdMember? @relation(fields: [householdMemberId], references: [id])
  month             DateTime // Format: YYYY-MM-01
  type              String           @default("personal") // TS enum: BUDGET_TYPE
  status            String           @default("draft") // TS enum: BUDGET_STATUS
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  payments     Payment[]
  transactions Transaction[]
  aiSummary    AISummary?

  @@index([householdId, householdMemberId, month])
}

model Category {
  id          String     @id @default(cuid())
  householdId String?
  household   Household? @relation(fields: [householdId], references: [id])
  name        String
  isBase      Boolean    @default(false)
  createdAt   DateTime   @default(now())

  transactions Transaction[]
  payments     Payment[]

  @@unique([name, householdId])
}

model Transaction {
  id              String         @id @default(cuid())
  householdId     String         @map("household_id")
  household       Household      @relation(fields: [householdId], references: [id])
  monthlyBudgetId String?        @map("monthly_budget_id")
  monthlyBudget   MonthlyBudget? @relation(fields: [monthlyBudgetId], references: [id])
  name            String
  amount          Float
  type            String         @default("expense") // TS enum: PAYMENT_TYPE
  categoryId      String?        @map("category_id")
  category        Category?      @relation(fields: [categoryId], references: [id])
  sourceAccountId String?        @map("source_account_id")
  destAccountId   String?        @map("dest_account_id")
  note            String?
  date            DateTime
  isRecurring     Boolean        @default(false) @map("is_recurring")
  recurrenceRule  Json?          @map("recurrence_rule") // Stores schedule/installment config
  createdAt       DateTime       @default(now()) @map("created_at")

  payments Payment[] // Links to monthly budget instances
  userId   String?
  user     User?     @relation(fields: [userId], references: [id])

  @@index([householdId])
  @@index([isRecurring])
  @@map("transactions")
}

model Payment {
  id                String           @id @default(cuid())
  monthlyBudgetId   String           @map("monthly_budget_id")
  monthlyBudget     MonthlyBudget    @relation(fields: [monthlyBudgetId], references: [id])
  transactionId     String?          @map("transaction_id")
  transaction       Transaction?     @relation(fields: [transactionId], references: [id])
  householdMemberId String?          @map("household_member_id")
  householdMember   HouseholdMember? @relation(fields: [householdMemberId], references: [id])

  amount          Float
  type            String       @default("expense") // TS enum: PAYMENT_TYPE
  categoryId      String?      @map("category_id")
  category        Category?    @relation(fields: [categoryId], references: [id])
  sourceAccountId String?      @map("source_account_id")
  sourceAccount   BankAccount? @relation("SourcePayments", fields: [sourceAccountId], references: [id])
  destAccountId   String?      @map("dest_account_id")
  destAccount     BankAccount? @relation("DestPayments", fields: [destAccountId], references: [id])

  note        String?
  date        DateTime
  splitConfig Json?    @map("split_config") // only for monthlyBudget as shared budget type => Stores strategy + per-member breakdown
  tags        Tag[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([monthlyBudgetId])
  @@index([transactionId])
  @@index([householdMemberId])
  @@index([categoryId])
  @@map("payments")
}

model Tag {
  id          String    @id @default(cuid())
  name        String
  householdId String    @map("household_id")
  household   Household @relation(fields: [householdId], references: [id])

  payments Payment[]

  @@unique([name, householdId])
  @@map("tags")
}

model AISummary {
  id              String        @id @default(cuid())
  monthlyBudgetId String        @unique @map("monthly_budget_id")
  monthlyBudget   MonthlyBudget @relation(fields: [monthlyBudgetId], references: [id])
  aiTask          String        @default("summarize_current") @map("ai_task") // TS enum: AI_TASK
  summary         String
  suggestions     String[]
  predictions     Json?         @map("predictions") // Structured JSON for next-month draft
  createdAt       DateTime      @default(now()) @map("created_at")
  household       Household?    @relation(fields: [householdId], references: [id])
  householdId     String?

  @@map("ai_summaries")
}
