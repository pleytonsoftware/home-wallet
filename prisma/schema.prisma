// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String            @id @default(uuid())
  email         String            @unique
  emailVerified DateTime?         @map("email_verified")
  name          String
  image         String?
  role          String            @default("MEMBER")
  createdAt     DateTime          @map("created_at") @default(now())
  
  accounts      Account[]
  sessions      Session[]
  memberships   HouseholdMember[]
  transactions   Transaction[]

  @@map("users")
}

model Household {
  id            String            @id @default(uuid())
  name          String
  splitStrategy String            @map("split_strategy") @default("PROPORTIONAL")
  createdAt     DateTime          @map("created_at") @default(now())
  
  members       HouseholdMember[]
  transactions  Transaction[]

  @@map("households")
}

model HouseholdMember {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  householdId String   @map("household_id")
  role        String   @default("MEMBER")
  joinedAt    DateTime @map("joined_at") @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId])
  @@map("household_members")
}

model Transaction {
  id            String   @id @default(uuid())
  amount        Decimal
  type          String
  category      String
  userId        String   @map("user_id")
  householdId   String?  @map("household_id")
  date          DateTime
  isRecurring   Boolean  @map("is_recurring")
  isInstallment Boolean  @map("is_installment")
  installmentId String?  @map("installment_id")
  description   String?
  createdAt     DateTime @map("created_at") @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
  installment Installment?

  @@map("transactions")
}

model Installment {
  id                String    @id @default(uuid())
  transactionId     String    @unique @map("transaction_id")
  totalAmount       Decimal   @map("total_amount")
  monthlyAmount     Decimal   @map("monthly_amount")
  remainingPayments Int       @map("remaining_payments")
  endDate           DateTime  @map("end_date")
  createdAt         DateTime  @map("created_at") @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@map("installments")
}

model Account {
  adapter           String    @id @default(cuid())
  userId            String    @map("user_id")
  type              String
  provider          String
  providerAccountId String    @map("provider_account_id")
  refreshToken      String?   @db.Text @map("refresh_token")
  accessToken       String?   @db.Text @map("access_token")
  expiresAt         Int?      @map("expires_at")
  tokenType         String?   @map("token_type")
  scope             String?
  idToken           String?   @db.Text @map("id_token")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
